# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public origin Printful can fetch for design files.
# Required for local webhook tests — Printful cannot reach localhost.
# Point at the deployed shop (studio marks + /api/studio-design live there).
FILE_PUBLIC_BASE_URL=https://shop.bluemoundlab.com

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Prod: Dashboard webhook endpoint signing secret for checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (Settings → API → personal access token)
PRINTFUL_API_KEY=

# Design uploads — local disk when S3_* is unset (dev default)
UPLOAD_DIR=./uploads

# Production object storage (S3-compatible, e.g. Cloudflare R2).
# When all of S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are set,
# uploads go to object storage instead of local disk.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=teebiz-designs
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public URL prefix for objects (R2 custom domain or public bucket URL)
# S3_PUBLIC_URL=https://designs.example.com
